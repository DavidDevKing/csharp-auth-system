# JWT Config
JWT__ACCESS__KEY=my_secure_access_key
JWT__ACCESS__ISSUER=http://localhost
JWT__ACCESS__AUDIENCE=http://localhost
JWT__ACCESS__EXPIRYMINUTES=15

JWT__REFRESH__KEY=my_secure_refresh_key
JWT__REFRESH__ISSUER=http://localhost
JWT__REFRESH__AUDIENCE=http://localhost
JWT__REFRESH__EXPIRYMINUTES=10080

JWT__INVITATION__KEY=my_secure_invitation_key
JWT__INVITATION__ISSUER=http://localhost
JWT__INVITATION__AUDIENCE=http://localhost
JWT__INVITATION__EXPIRYMINUTES=1440

# Database Config
CONNECTIONSTRINGS__DEFAULTCONNECTION=Host=db;Database=auth_db;Username=auth_user;Password=my_db_password;Port=5432

# Database Seed Config
DB_SEED__FIRSTNAME=John
DB_SEED__LASTNAME=Doe
DB_SEED__EMAIL=johndoe@example.com
DB_SEED__PASSWORD=my_password

# Dotnet Config
DOTNET_USE_POLLING_FILE_WATCHER=true
ASPNETCORE_URLS=http://*:5227
ASPNETCORE_ENVIRONMENT=Development


# Email Config
EMAIL_SETTINGS__SERVER=smtp.example.com
EMAIL_SETTINGS__PORT=465
EMAIL_SETTINGS__SENDEREMAIL=johndoe@example.com
EMAIL_SETTINGS__USERNAME=johndoe@example.com
EMAIL_SETTINGS__SENDERNAME=csharp-auth-system
EMAIL_SETTINGS__PASSWORD=my_app_password